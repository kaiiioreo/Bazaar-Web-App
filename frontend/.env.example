# Only needed when the backend is deployed somewhere else (e.g. Render).
# In local development, leave this unset: Vite forwards /api to localhost:4000.
# VITE_API_URL="https://your-backend.onrender.com/api"

# Minutes without activity before a signed-in user is logged out (default 15). Set to 1 for a live demo.
# There should be a .env file in frontend src for the live demo idle logout to work
# VITE_IDLE_MINUTES=15
