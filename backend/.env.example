# Copy this file to .env and fill in the values. Never commit .env.

# Postgres connection string (Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bazaar"

# Any long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

PORT=4000
CLIENT_URL="http://localhost:5173"

# AI (optional). Leave AI_API_KEY empty to use the built-in fallbacks.
# AI_PROVIDER is "anthropic" or "openai".
AI_PROVIDER="anthropic"
AI_API_KEY=""
AI_MODEL="claude-haiku-5-5"

# Email (optional). If empty, reset links are printed in the backend terminal instead.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, and an App Password.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Bazaar <no-reply@bazaar.ph>"
