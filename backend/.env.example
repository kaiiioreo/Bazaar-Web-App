# Copy this file to .env and fill in the values. Never commit .env.

# Postgres connection string (Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bazaar"

# Any long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

PORT=4000
CLIENT_URL="http://localhost:5173"

# AI (optional). Leave AI_API_KEY empty to use the built-in fallbacks.
# AI_PROVIDER is "gemini" (free tier), "anthropic", or "openai".
# Free Gemini key: https://aistudio.google.com/apikey
# Check your settings with: npm run ai:check
AI_PROVIDER="gemini"
AI_API_KEY=""
AI_MODEL="gemini-flash-latest"

# Email (optional). If empty, reset links are printed in the backend terminal instead.
# Gmail: SMTP_PASS is a 16-letter App Password (Google Account > Security > App passwords), not the Gmail password.
# Leave SMTP_PASS empty to print emails in the terminal instead.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="bazaar.system23@gmail.com"
SMTP_PASS=""
EMAIL_FROM="Bazaar <bazaar.system23@gmail.com>"
