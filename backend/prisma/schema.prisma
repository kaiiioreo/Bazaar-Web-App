// Bazaar database schema (SDD Section 4.2 data dictionary, plus the fields the UI needs).
// Only ONE person should edit this file. After editing, run: npm run db:push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  vendor
  customer
}

enum UserStatus {
  active
  suspended
  deactivated
}

enum ApplicationStatus {
  pending
  approved
  rejected
}

enum EventStatus {
  upcoming
  ongoing
  completed
  cancelled
}

enum SlotStatus {
  available
  assigned
}

enum ScheduleStatus {
  pre_registered
  assigned
}

enum StockStatus {
  in_stock
  low_stock
  out_of_stock
}

enum FavoriteType {
  vendor
  product
}

enum ReviewStatus {
  visible
  removed
}

model User {
  user_id          Int        @id @default(autoincrement())
  name             String
  email            String     @unique
  password_hash    String
  role             Role
  status           UserStatus @default(active)
  reset_token_hash String?
  reset_expires    DateTime?
  created_at       DateTime   @default(now())

  vendor_profile VendorProfile?
  applications   VendorApplication[]
  favorites      Favorite[]
  reviews        Review[]
  notifications  Notification[]
  events_created BazaarEvent[]

  @@map("users")
}

model VendorApplication {
  application_id   Int               @id @default(autoincrement())
  user_id          Int
  business_name    String
  product_category String
  business_details String
  status           ApplicationStatus @default(pending)
  ai_flag          Boolean           @default(false)
  ai_flag_reason   String?
  rejection_reason String?
  submitted_at     DateTime          @default(now())
  reviewed_at      DateTime?

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("vendor_applications")
}

model VendorProfile {
  vendor_id             Int       @id // same as the vendor's user_id
  business_name         String
  category              String
  description           String    @default("")
  profile_image         String? // URL or small data URL
  contact_info          String?
  contact_phone         String?
  ai_summary            String?
  ai_summary_updated_at DateTime?

  user      User             @relation(fields: [vendor_id], references: [user_id], onDelete: Cascade)
  products  Product[]
  schedules VendorSchedule[]
  slots     BazaarSlot[]
  reviews   Review[]
  favorites Favorite[]

  @@map("vendor_profiles")
}

model Product {
  product_id   Int         @id @default(autoincrement())
  vendor_id    Int
  name         String
  description  String      @default("")
  price        Decimal     @db.Decimal(10, 2)
  category     String
  stock_status StockStatus @default(in_stock)
  image        String?
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  vendor    VendorProfile @relation(fields: [vendor_id], references: [vendor_id], onDelete: Cascade)
  favorites Favorite[]

  @@map("products")
}

model BazaarEvent {
  event_id          Int         @id @default(autoincrement())
  name              String
  date              DateTime    @db.Date
  location          String
  total_slots       Int
  status            EventStatus @default(upcoming)
  registration_open Boolean     @default(true)
  created_by        Int?
  created_at        DateTime    @default(now())

  creator   User?            @relation(fields: [created_by], references: [user_id], onDelete: SetNull)
  slots     BazaarSlot[]
  schedules VendorSchedule[]

  @@map("bazaar_events")
}

model BazaarSlot {
  slot_id   Int        @id @default(autoincrement())
  event_id  Int
  label     String // e.g. "A-03"
  vendor_id Int?
  status    SlotStatus @default(available)

  event    BazaarEvent     @relation(fields: [event_id], references: [event_id], onDelete: Cascade)
  vendor   VendorProfile?  @relation(fields: [vendor_id], references: [vendor_id], onDelete: SetNull)
  schedule VendorSchedule?

  @@unique([event_id, label])
  @@unique([event_id, vendor_id])
  @@map("bazaar_slots")
}

model VendorSchedule {
  schedule_id   Int            @id @default(autoincrement())
  vendor_id     Int
  event_id      Int
  slot_id       Int?           @unique
  status        ScheduleStatus @default(pre_registered)
  registered_at DateTime       @default(now())

  vendor VendorProfile @relation(fields: [vendor_id], references: [vendor_id], onDelete: Cascade)
  event  BazaarEvent   @relation(fields: [event_id], references: [event_id], onDelete: Cascade)
  slot   BazaarSlot?   @relation(fields: [slot_id], references: [slot_id], onDelete: SetNull)

  @@unique([vendor_id, event_id])
  @@map("vendor_schedules")
}

model Favorite {
  favorite_id Int          @id @default(autoincrement())
  customer_id Int
  target_type FavoriteType
  vendor_id   Int?
  product_id  Int?
  created_at  DateTime     @default(now())

  customer User           @relation(fields: [customer_id], references: [user_id], onDelete: Cascade)
  vendor   VendorProfile? @relation(fields: [vendor_id], references: [vendor_id], onDelete: Cascade)
  product  Product?       @relation(fields: [product_id], references: [product_id], onDelete: Cascade)

  @@unique([customer_id, vendor_id])
  @@unique([customer_id, product_id])
  @@map("favorites")
}

model Review {
  review_id      Int          @id @default(autoincrement())
  customer_id    Int
  vendor_id      Int
  rating         Int
  comment        String
  status         ReviewStatus @default(visible)
  ai_flag        Boolean      @default(false)
  ai_flag_reason String?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  customer User          @relation(fields: [customer_id], references: [user_id], onDelete: Cascade)
  vendor   VendorProfile @relation(fields: [vendor_id], references: [vendor_id], onDelete: Cascade)

  @@unique([customer_id, vendor_id]) // one review per customer per vendor
  @@map("reviews")
}

model Notification {
  notification_id Int      @id @default(autoincrement())
  user_id         Int
  type            String // schedule_update, restock, application_status, event_cancelled, ...
  message         String
  link            String?
  is_read         Boolean  @default(false)
  created_at      DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("notifications")
}
